# AlertGuard web fleet dashboard — local dev environment template.
# Copy to `.env.local` (gitignored, see frontend/.gitignore) and fill in real
# values from your Supabase project: Project Settings -> API.
#
# Only NEXT_PUBLIC_* / public-safe values belong in this file — everything
# prefixed NEXT_PUBLIC_ is shipped straight into the browser bundle. The
# service_role key and any OAuth client secret must NEVER appear here; those
# live only in backend/.env (Edge Function secrets) and the Supabase
# dashboard's Auth provider config, respectively. See
# docs/AlertGuard-Integration-Setup-Guide.md Sections 1 and 2 for the full
# walkthrough.

# Project Settings -> API -> Project URL
NEXT_PUBLIC_SUPABASE_URL=

# Project Settings -> API -> anon / public key
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Optional (Section 7 of the integration guide) — Sentry error monitoring.
# Leave blank until you've run `npx @sentry/wizard@latest -i nextjs`.
NEXT_PUBLIC_SENTRY_DSN=
