# AlertGuard backend — environment variables
# Copy to `.env` for local Supabase CLI use (`.env` is gitignored) and set the
# real values as Supabase Edge Function secrets in staging/production via
# `supabase secrets set --env-file .env` (never commit real values).

# --- Supabase core (Section 1 / Step 1) ---
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_ANON_KEY=
# NEVER ship this to the mobile app bundle. Edge Function secrets only.
SUPABASE_SERVICE_ROLE_KEY=

# --- Internal function-to-function auth (Section 13) ---
# Shared secret required on the `x-internal-secret` header for calls between
# Edge Functions (verify-session -> calculate-reward -> trigger-payout, the
# reconciliation cron, fleet-reports cron). Generate with e.g. `openssl rand
# -hex 32`. Must match the value stored in Supabase Vault as
# 'internal_function_secret' for the pg_cron jobs (see
# supabase/migrations/20260101000005_pg_cron_jobs.sql).
INTERNAL_FUNCTION_SECRET=

# --- Rewards (Section 10.2 / Section 14 open question) ---
# Token rate per safety point. Provisional; PRD Section 14 flags the funding
# model / rate as unresolved pending fleet-subscription revenue modeling.
TOKEN_RATE_PER_POINT=0.01

# --- Stacks settlement (Section 10.3; Smart Contract PRD Section 5-9) ---
STACKS_NETWORK=testnet
STACKS_REWARD_CONTRACT_ADDRESS=
STACKS_CONTRACT_NAME=alertguard-rewards
STACKS_MINT_FUNCTION_NAME=mint-reward
# NEVER commit. v1.1: migrate to a multisig per Smart Contract PRD Section 7.
REWARD_POOL_PRIVATE_KEY=
REWARD_POOL_WALLET_ADDRESS=
STACKS_API_BASE_URL=https://api.testnet.hiro.so

# --- SMS provider (Section 10.4 / Section 14 open question) ---
# "termii" (provisional default, see _shared/notifications.ts) or
# "africas_talking".
SMS_PROVIDER=termii
TERMII_API_KEY=
TERMII_SENDER_ID=AlertGuard
AFRICAS_TALKING_API_KEY=
AFRICAS_TALKING_USERNAME=
AFRICAS_TALKING_SENDER_ID=

# --- Redemptions / VTU (Section 10.5) ---
VTPASS_API_KEY=
